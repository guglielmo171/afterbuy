// Product contract: docs/editorial/product-contract.md §5–10

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ReturnStatus {
  not_planned
  return_planned
  returned
  closed
}

enum RefundStatus {
  not_expected
  pending
  received
  issue
}

model Store {
  id                      String     @id @default(cuid())
  name                    String     @unique
  defaultReturnPolicyDays Int?
  purchases               Purchase[]
}

model Purchase {
  id           String   @id @default(cuid())
  productName  String
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  category     String?
  purchaseDate DateTime
  priceCents   Int
  currency     String   @default("EUR")

  returnCase     ReturnCase?
  refund         Refund?
  warranty       Warranty?
  documents      PurchaseDocument[]
  timelineEvents TimelineEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReturnCase {
  id               String       @id @default(cuid())
  purchaseId       String       @unique
  purchase         Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  returnPolicyDays Int
  returnDeadline   DateTime
  status           ReturnStatus @default(not_planned)
}

model Refund {
  id                  String       @id @default(cuid())
  purchaseId          String       @unique
  purchase            Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  status              RefundStatus @default(pending)
  expectedAmountCents Int?
  receivedAmountCents Int?
  receivedAt          DateTime?
  notes               String?
}

model Warranty {
  id             String   @id @default(cuid())
  purchaseId     String   @unique
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  durationMonths Int
  expiresAt      DateTime
  notes          String?
}

model PurchaseDocument {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  type       String
  label      String?
  url        String?
  isPresent  Boolean  @default(false)
  notes      String?
}

model TimelineEvent {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  type        String
  description String
  occurredAt  DateTime @default(now())
}
